# Outreach Automation - Environment Configuration
# Copy this file to .env and fill in your values
# NOTE: In production, ensure all required values are set properly

# =============================================================================
# APPLICATION
# =============================================================================
APP_ENV=development  # development | staging | production
APP_DEBUG=false      # Must be false in production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=your-secret-key-at-least-32-characters-long  # REQUIRED

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000"]

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/outreach
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600

# =============================================================================
# REDIS / CELERY
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# INTEGRATIONS
# =============================================================================

# SmartLead
SMARTLEAD_API_KEY=your-smartlead-api-key
SMARTLEAD_WEBHOOK_SECRET=your-webhook-secret

# HubSpot (REQUIRED in production)
HUBSPOT_ACCESS_TOKEN=your-hubspot-access-token
HUBSPOT_API_BASE_URL=https://api.hubapi.com

# Apollo.io
APOLLO_API_KEY=your-apollo-api-key

# ConnectSafely (LinkedIn)
CONNECTSAFELY_API_KEY=your-connectsafely-api-key
CONNECTSAFELY_WEBHOOK_SECRET=your-webhook-secret

# MS Teams
MSTEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-webhook-url

# OpenAI (REQUIRED in production)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=1000

# =============================================================================
# MONITORING
# =============================================================================
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_FORMAT=json  # json | console

# =============================================================================
# SCHEDULER
# =============================================================================
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_MINUTE=100
WEBHOOK_RATE_LIMIT_PER_MINUTE=1000
